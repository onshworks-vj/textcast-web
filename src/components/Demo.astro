---
import type { Strings } from '../i18n/strings';
interface Props {
  t: Strings;
}
const { t } = Astro.props;
---

<section id="demo" class="relative overflow-hidden border-t border-[var(--color-border-soft)] bg-[var(--color-bg-elev)]">
  <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{t.demo.title}</h2>
      <p class="mt-4 text-[var(--color-text-muted)]">{t.demo.desc}</p>
    </div>

    <div class="mx-auto mt-10 max-w-xs md:max-w-sm">
      <img
        src="/demo.png"
        alt="TextCast v0.1.3"
        width="1024"
        height="1760"
        loading="lazy"
        class="block h-auto w-full"
      />
    </div>
  </div>
</section>
