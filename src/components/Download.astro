---
import type { Strings } from '../i18n/strings';
import { getLatestRelease } from '../lib/releases';
interface Props {
  t: Strings;
}
const { t } = Astro.props;

const { version: VERSION, macUrl: MAC_URL, winUrl: WIN_URL, releasesUrl: RELEASES_URL } = await getLatestRelease();

const LICENSE_URL = 'https://onsight3.gumroad.com/l/TextCastbeta';
---

<section id="download" class="relative border-t border-[var(--color-border-soft)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs tracking-widest text-[var(--color-brand)] uppercase">{t.download.version} · {VERSION}</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{t.download.title}</h2>
      <p class="mt-4 text-[var(--color-text-muted)]">{t.download.subtitle}</p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl">
      <div class="relative overflow-hidden rounded-2xl border border-[var(--color-brand)]/40 bg-[var(--color-bg-card)] p-6 md:p-7">
        <div
          class="pointer-events-none absolute inset-0 opacity-50"
          style="background: radial-gradient(80% 120% at 0% 0%, rgba(128,255,210,0.18), transparent 60%);"
          aria-hidden="true"
        ></div>
        <div class="relative flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <div class="flex items-start gap-4">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <div>
              <span class="text-[10px] tracking-[0.3em] text-[var(--color-brand)] uppercase">{t.download.license.step}</span>
              <div class="mt-1 text-lg font-semibold tracking-tight">{t.download.license.title}</div>
              <p class="mt-1 max-w-md text-sm text-[var(--color-text-muted)]">{t.download.license.desc}</p>
            </div>
          </div>
          <a
            href={LICENSE_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full gradient-bg px-5 py-3 text-sm font-semibold text-black shadow-lg transition hover:brightness-110 glow-brand"
          >
            {t.download.license.cta}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        </div>
        <p class="relative mt-4 text-xs text-[var(--color-text-dim)]">{t.download.license.note}</p>
      </div>

      <div class="mt-8 flex items-center gap-3">
        <span class="text-[10px] tracking-[0.3em] text-[var(--color-text-muted)] uppercase">{t.download.downloadStep}</span>
        <span class="h-px flex-1 bg-[var(--color-border-soft)]"></span>
      </div>
    </div>

    <div class="mx-auto mt-6 grid max-w-3xl gap-4 md:grid-cols-2">
      <a
        href={MAC_URL}
        class="group flex items-center justify-between rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] px-6 py-5 transition hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-bg-elev)]"
      >
        <div class="flex items-center gap-4">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.41-1.09-.47-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.41C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          </span>
          <div>
            <div class="font-semibold">{t.download.mac}</div>
            <div class="text-xs text-[var(--color-text-muted)]">macOS 11+ · Universal</div>
          </div>
        </div>
        <svg class="text-[var(--color-text-dim)] group-hover:text-[var(--color-brand)] transition-colors" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
      </a>

      <a
        href={WIN_URL}
        class="group flex items-center justify-between rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] px-6 py-5 transition hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-bg-elev)]"
      >
        <div class="flex items-center gap-4">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5 10.5 4v7.5H3V5.5zm0 13V11h7.5v7.5L3 18.5zM11.5 4 21 3v8.5h-9.5V4zm0 7.5H21V20l-9.5-1.5v-7z"/></svg>
          </span>
          <div>
            <div class="font-semibold">{t.download.win}</div>
            <div class="text-xs text-[var(--color-text-muted)]">Windows 10+ · x64</div>
          </div>
        </div>
        <svg class="text-[var(--color-text-dim)] group-hover:text-[var(--color-brand)] transition-colors" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
      </a>
    </div>

    <p class="mt-6 text-center text-xs text-[var(--color-text-dim)]">
      {t.download.note} · <a href={RELEASES_URL} class="underline decoration-dotted underline-offset-4 hover:text-[var(--color-brand)]">{t.download.checksum}</a>
    </p>
  </div>
</section>
