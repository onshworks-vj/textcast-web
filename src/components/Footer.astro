---
import type { Strings } from '../i18n/strings';
interface Props {
  t: Strings;
}
const { t } = Astro.props;

const RELEASES_URL = 'https://github.com/onshworks-vj/textcast-releases/releases';
const CONTACT_URL = 'mailto:on.sh996@gmail.com';
---

<footer class="border-t border-[var(--color-border-soft)] bg-[var(--color-bg)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-[2fr_1fr]">
    <div>
      <div class="flex items-center gap-2 font-semibold tracking-tight">
        <img src="/icon.png" alt="TextCast" width="22" height="22" class="rounded-md" />
        TextCast
      </div>
      <p class="mt-3 max-w-sm text-sm text-[var(--color-text-muted)]">{t.footer.tagline}</p>
    </div>

    <div class="flex flex-col gap-2 text-sm md:items-end">
      <a href="#download" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">{t.footer.links.download}</a>
      <a href={RELEASES_URL} class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">{t.footer.links.releases}</a>
      <a href={CONTACT_URL} class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">{t.footer.links.contact}</a>
    </div>
  </div>
  <div class="border-t border-[var(--color-border-soft)]">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 text-xs text-[var(--color-text-dim)]">
      <span>{t.footer.rights}</span>
      <span class="tracking-widest">textcast.kr</span>
    </div>
  </div>
</footer>
