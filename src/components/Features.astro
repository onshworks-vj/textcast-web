---
import type { Strings } from '../i18n/strings';
interface Props {
  t: Strings;
}
const { t } = Astro.props;

const icons = [
  // queue / broadcast
  '<path d="M4 6h12"/><path d="M4 12h8"/><path d="M4 18h10"/><path d="m18 8 4 4-4 4"/>',
  // song / list
  '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  // animation / motion
  '<path d="M3 12h3l3-8 4 16 3-8h5"/>',
  // typography
  '<path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/>',
  // alpha / layers
  '<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
  // performance / gauge
  '<path d="M12 14a4 4 0 0 0 4-4"/><path d="M12 2a10 10 0 1 0 10 10"/><path d="m16 8-4 4"/>',
];
---

<section id="features" class="relative border-t border-[var(--color-border-soft)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{t.features.title}</h2>
      <p class="mt-4 text-[var(--color-text-muted)]">{t.features.subtitle}</p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {t.features.items.map((item, i) => (
        <article class:list={[
          'group relative border p-6 transition',
          item.comingSoon
            ? 'border-[var(--color-border-soft)] bg-[var(--color-bg-card)]/60 opacity-70'
            : 'border-[var(--color-border-soft)] bg-[var(--color-bg-card)] hover:border-[var(--color-brand)]/40',
        ]}>
          {item.comingSoon && (
            <span class="absolute right-4 top-4 border border-[var(--color-border)] bg-[var(--color-bg-elev)] px-2.5 py-0.5 text-[10px] font-medium tracking-wide text-[var(--color-text-muted)]">
              {t.features.comingSoon}
            </span>
          )}
          <div class="mb-5 inline-flex h-10 w-10 items-center justify-center border border-[var(--color-border)] bg-[var(--color-bg-elev)] text-[var(--color-brand)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
          </div>
          <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{item.desc}</p>
        </article>
      ))}
    </div>

    <div class="mt-16 grid gap-4 border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] p-8 md:grid-cols-[1fr_1fr_2fr] md:items-center">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-8 w-8 items-center justify-center border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.41-1.09-.47-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.41C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
        </span>
        <span class="font-medium">{t.platforms.mac}</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="inline-flex h-8 w-8 items-center justify-center border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5 10.5 4v7.5H3V5.5zm0 13V11h7.5v7.5L3 18.5zM11.5 4 21 3v8.5h-9.5V4zm0 7.5H21V20l-9.5-1.5v-7z"/></svg>
        </span>
        <span class="font-medium">{t.platforms.win}</span>
      </div>
      <p class="text-sm text-[var(--color-text-muted)]">{t.platforms.hint}</p>
    </div>
  </div>
</section>
