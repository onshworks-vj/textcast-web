---
import type { Strings } from '../i18n/strings';
interface Props {
  t: Strings;
}
const { t } = Astro.props;
---

<section id="faq" class="relative border-t border-[var(--color-border-soft)] bg-[var(--color-bg)]">
  <div class="mx-auto max-w-3xl px-6 py-20 md:py-28">
    <div class="text-center">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{t.faq.title}</h2>
    </div>

    <div class="mt-12 space-y-3">
      {t.faq.items.map((item) => (
        <details class="group rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] transition hover:border-[var(--color-border)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-left font-medium">
            <span>{item.q}</span>
            <svg class="shrink-0 text-[var(--color-text-muted)] transition group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="px-6 pb-5 text-sm leading-relaxed text-[var(--color-text-muted)]">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
