---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { strings } from '../i18n/strings';
import { invitees } from '../data/invitees';
import { getLatestRelease } from '../lib/releases';

export async function getStaticPaths() {
  return invitees.map((i) => ({ params: { invitee: i.slug }, props: { invitee: i } }));
}

const { invitee } = Astro.props;
const t = strings.ko;

const { version: VERSION, macUrl: MAC_URL, winUrl: WIN_URL, releasesUrl: RELEASES_URL } =
  await getLatestRelease();

const SUPABASE_URL = 'https://axqsmgiawqjpndmihvgc.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_6a0A-U-afyNFP1AP7pkKZA_sWGtDWmj';

const highlights = [
  {
    title: '실시간 텍스트 송출',
    desc: '대기열에 쌓아둔 문장을 한 번의 클릭으로 즉시 송출합니다.',
  },
  {
    title: '15종 애니메이션',
    desc: '페이드 · 슬라이드 · 줌 · 블러. 글자/단어/줄 단위로 세밀하게 조정됩니다.',
  },
  {
    title: '알파 · 크로마키 출력',
    desc: '투명 배경으로 영상 위에 바로 오버레이하거나 크로마키 합성할 수 있습니다.',
  },
];
---

<Layout
  lang="ko"
  title={`TextCast — ${invitee.displayName} 님을 위한 초대`}
  description={`${invitee.displayName} 님께 먼저 전하는 TextCast 프리뷰 초대입니다.`}
>
  <header class="sticky top-0 z-50 border-b border-[var(--color-border-soft)]/80 bg-[var(--color-bg)]/75 backdrop-blur-xl">
    <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <img src="/icon.png" alt="TextCast" width="24" height="24" class="rounded-md" />
        <span>TextCast</span>
      </a>
      <span class="text-xs tracking-widest text-[var(--color-brand)] uppercase">Private Invite</span>
    </nav>
  </header>

  <main id="invite-active" data-license-key={invitee.licenseKey}>
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 hero-grid pointer-events-none" aria-hidden="true"></div>
      <div
        class="absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full opacity-40 blur-3xl pointer-events-none"
        style="background: radial-gradient(closest-side, rgba(128,255,210,0.25), transparent 70%);"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto flex max-w-4xl flex-col items-center px-6 pt-20 pb-16 text-center md:pt-28 md:pb-20">
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elev)] px-3 py-1 text-xs tracking-wide text-[var(--color-text-muted)]">
          Beta {VERSION}
        </span>

        <h1 class="mt-6 text-3xl font-semibold leading-tight tracking-tight md:text-5xl md:leading-[1.1]">
          {invitee.greeting}
        </h1>

        <p class="mt-6 max-w-2xl whitespace-pre-line text-base text-[var(--color-text-muted)] md:text-lg">
          {invitee.message}
        </p>

        <div class="mt-10 w-full max-w-xl rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] p-5 text-left">
          <div class="flex items-center justify-between">
            <span class="text-[10px] tracking-[0.3em] text-[var(--color-brand)] uppercase">License</span>
            <span class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">앱 실행 시 입력</span>
          </div>

          <div class="mt-4 space-y-3">
            <div>
              <label class="text-xs text-[var(--color-text-muted)]">이메일</label>
              <div class="mt-1 flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2">
                <code class="flex-1 truncate font-mono text-sm text-[var(--color-text)]">{invitee.licenseEmail}</code>
                <button
                  type="button"
                  class="copy-btn inline-flex items-center gap-1 rounded-md border border-[var(--color-border)] px-2 py-1 text-xs text-[var(--color-text-muted)] transition hover:border-[var(--color-brand)]/60 hover:text-[var(--color-text)]"
                  data-copy={invitee.licenseEmail}
                  aria-label="이메일 복사"
                >
                  <svg class="copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <span class="copy-label">복사</span>
                </button>
              </div>
            </div>

            <div>
              <label class="text-xs text-[var(--color-text-muted)]">라이선스 코드</label>
              <div class="mt-1 flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2">
                <code
                  class="license-key flex-1 truncate font-mono text-sm tracking-[0.35em] text-[var(--color-text)] select-none"
                  data-value={invitee.licenseKey}
                  data-masked={'•'.repeat(Math.max(8, invitee.licenseKey.length))}
                >{'•'.repeat(Math.max(8, invitee.licenseKey.length))}</code>
                <button
                  type="button"
                  class="reveal-btn inline-flex items-center justify-center rounded-md border border-[var(--color-border)] p-1.5 text-[var(--color-text-muted)] transition hover:border-[var(--color-brand)]/60 hover:text-[var(--color-text)]"
                  aria-label="라이선스 코드 표시"
                  aria-pressed="false"
                >
                  <svg class="eye-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
                <button
                  type="button"
                  class="copy-btn inline-flex items-center gap-1 rounded-md border border-[var(--color-border)] px-2 py-1 text-xs text-[var(--color-text-muted)] transition hover:border-[var(--color-brand)]/60 hover:text-[var(--color-text)]"
                  data-copy={invitee.licenseKey}
                  aria-label="라이선스 코드 복사"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <span class="copy-label">복사</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 grid w-full max-w-xl gap-3 sm:grid-cols-2">
          <a
            href={MAC_URL}
            class="group flex items-center justify-between rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] px-5 py-4 transition hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-bg-elev)]"
          >
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.41-1.09-.47-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.41C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
              </span>
              <div class="text-left">
                <div class="font-semibold">macOS</div>
                <div class="text-xs text-[var(--color-text-muted)]">11+ · Universal</div>
              </div>
            </div>
            <svg class="text-[var(--color-text-dim)] group-hover:text-[var(--color-brand)] transition-colors" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>

          <a
            href={WIN_URL}
            class="group flex items-center justify-between rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] px-5 py-4 transition hover:border-[var(--color-brand)]/50 hover:bg-[var(--color-bg-elev)]"
          >
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-brand)]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5 10.5 4v7.5H3V5.5zm0 13V11h7.5v7.5L3 18.5zM11.5 4 21 3v8.5h-9.5V4zm0 7.5H21V20l-9.5-1.5v-7z"/></svg>
              </span>
              <div class="text-left">
                <div class="font-semibold">Windows</div>
                <div class="text-xs text-[var(--color-text-muted)]">10+ · x64</div>
              </div>
            </div>
            <svg class="text-[var(--color-text-dim)] group-hover:text-[var(--color-brand)] transition-colors" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
        </div>

      </div>
    </section>

    <section class="border-t border-[var(--color-border-soft)] bg-[var(--color-bg)]">
      <div class="mx-auto max-w-4xl px-6 py-16 md:py-20">
        <div class="grid gap-4 md:grid-cols-3">
          {
            highlights.map((h) => (
              <div class="rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-bg-card)] p-5">
                <div class="text-sm font-semibold">{h.title}</div>
                <p class="mt-2 text-sm text-[var(--color-text-muted)]">{h.desc}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-8 text-center text-xs text-[var(--color-text-dim)]">
          전체 기능은 <a href="/ko/" class="underline decoration-dotted underline-offset-4 hover:text-[var(--color-brand)]">홈</a> 에서 확인하실 수 있습니다 ·
          <a href={RELEASES_URL} class="underline decoration-dotted underline-offset-4 hover:text-[var(--color-brand)]">릴리즈 노트</a>
        </p>
      </div>
    </section>
  </main>

  <main id="invite-expired" class="hidden">
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 hero-grid pointer-events-none" aria-hidden="true"></div>

      <div class="relative mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-6 py-24 text-center">
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elev)] px-3 py-1 text-[10px] tracking-[0.3em] text-[var(--color-text-muted)] uppercase">
          Invitation Expired
        </span>

        <h1 class="mt-8 text-3xl font-semibold leading-tight tracking-tight md:text-5xl">
          만료된 초대장입니다
        </h1>
        <p class="mt-4 max-w-md text-sm text-[var(--color-text-muted)] md:text-base">
          이 초대장은 이미 사용되었습니다.<br />
          이후 버전은 공개 릴리즈에서 받으실 수 있습니다.
        </p>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row">
          <a
            href="/ko/"
            class="inline-flex items-center gap-2 rounded-full gradient-bg px-6 py-3 text-sm font-semibold text-black shadow-lg transition hover:brightness-110 glow-brand"
          >
            TextCast 홈으로
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} />
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  (async () => {
    const active = document.getElementById('invite-active');
    const expired = document.getElementById('invite-expired');
    const key = active?.dataset.licenseKey;
    if (!active || !expired || !key) return;
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/licenses?license_key=eq.${encodeURIComponent(key)}&select=machine_id,status`,
        {
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          },
        }
      );
      if (!res.ok) return;
      const rows = await res.json();
      const row = rows?.[0];
      if (!row) return;
      if (row.machine_id || row.status !== 'active') {
        active.classList.add('hidden');
        expired.classList.remove('hidden');
      }
    } catch {
      /* network failure → leave active view */
    }
  })();
</script>

<script>
  document.querySelectorAll<HTMLButtonElement>('.reveal-btn').forEach((btn) => {
    const wrap = btn.closest('div');
    const code = wrap?.querySelector<HTMLElement>('.license-key');
    if (!code) return;
    const masked = code.dataset.masked ?? '';
    const value = code.dataset.value ?? '';
    btn.addEventListener('click', () => {
      const shown = btn.getAttribute('aria-pressed') === 'true';
      const next = !shown;
      btn.setAttribute('aria-pressed', String(next));
      code.textContent = next ? value : masked;
      code.classList.toggle('select-none', !next);
      code.classList.toggle('tracking-[0.35em]', !next);
      code.classList.toggle('tracking-wider', next);
      btn.setAttribute('aria-label', next ? '라이선스 코드 숨기기' : '라이선스 코드 표시');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = value;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const label = btn.querySelector<HTMLElement>('.copy-label');
      if (!label) return;
      const prev = label.textContent;
      label.textContent = '복사됨';
      btn.classList.add('text-[var(--color-brand)]');
      setTimeout(() => {
        label.textContent = prev;
        btn.classList.remove('text-[var(--color-brand)]');
      }, 1500);
    });
  });
</script>
