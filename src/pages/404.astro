---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { strings } from '../i18n/strings';

const t = strings.ko;
---

<Layout
  lang="ko"
  title="TextCast — 404"
  description="찾으시는 페이지가 송출되지 않았습니다."
>
  <header class="sticky top-0 z-50 border-b border-[var(--color-border-soft)]/80 bg-[var(--color-bg)]/75 backdrop-blur-xl">
    <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <img src="/icon.png" alt="TextCast" width="24" height="24" class="rounded-md" />
        <span>TextCast</span>
      </a>
      <span class="text-xs tracking-widest text-[var(--color-text-muted)] uppercase">Off Air</span>
    </nav>
  </header>

  <main>
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 hero-grid pointer-events-none" aria-hidden="true"></div>
      <div
        class="absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full opacity-30 blur-3xl pointer-events-none"
        style="background: radial-gradient(closest-side, rgba(128,255,210,0.20), transparent 70%);"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-6 py-24 text-center">
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elev)] px-3 py-1 text-[10px] tracking-[0.3em] text-[var(--color-text-muted)] uppercase">
          Signal Lost
        </span>

        <div class="relative mt-10">
          <h1
            class="glitch select-none text-[96px] font-semibold leading-none tracking-tight md:text-[180px]"
            data-text="404"
          >
            404
          </h1>
        </div>

        <h2 class="mt-8 text-xl font-semibold tracking-tight md:text-2xl">
          이 페이지는 송출되지 않았습니다
        </h2>
        <p class="mt-3 max-w-md text-sm text-[var(--color-text-muted)] md:text-base">
          주소가 바뀌었거나, 초대장 경로가 다를 수 있습니다.
        </p>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-full gradient-bg px-6 py-3 text-sm font-semibold text-black shadow-lg transition hover:brightness-110 glow-brand"
          >
            홈으로 돌아가기
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="/ko/"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elev)] px-6 py-3 text-sm font-medium text-[var(--color-text)] transition hover:border-[var(--color-brand)]/60"
          >
            다운로드 보기
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} />
</Layout>

<style>
  .glitch {
    position: relative;
    color: var(--color-text);
    text-shadow: 0 0 40px rgba(128, 255, 210, 0.15);
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glitch::before {
    color: rgba(128, 255, 210, 0.85);
    mix-blend-mode: screen;
    transform: translate(-2px, 0);
    animation: glitch-a 4s infinite steps(1);
    clip-path: polygon(0 0, 100% 0, 100% 38%, 0 38%);
  }
  .glitch::after {
    color: rgba(255, 90, 140, 0.75);
    mix-blend-mode: screen;
    transform: translate(2px, 0);
    animation: glitch-b 4s infinite steps(1);
    clip-path: polygon(0 62%, 100% 62%, 100% 100%, 0 100%);
  }
  @keyframes glitch-a {
    0%, 92%, 100% { transform: translate(-2px, 0); opacity: 0.9; }
    93% { transform: translate(-6px, -1px); opacity: 1; }
    95% { transform: translate(1px, 2px); opacity: 0.6; }
    97% { transform: translate(-4px, 0); opacity: 1; }
  }
  @keyframes glitch-b {
    0%, 90%, 100% { transform: translate(2px, 0); opacity: 0.8; }
    91% { transform: translate(5px, 1px); opacity: 1; }
    94% { transform: translate(-1px, -2px); opacity: 0.5; }
    96% { transform: translate(3px, 0); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .glitch::before,
    .glitch::after {
      animation: none;
    }
  }
</style>
